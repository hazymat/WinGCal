<Window x:Class="WinGCal.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinGCal Settings" Icon="Assets/WinGCal.ico" Width="820" Height="580" MinWidth="680" MinHeight="460" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="Label"><Setter Property="Margin" Value="0,10,0,3" /></Style>
    <Style TargetType="TextBlock" x:Key="Quiet"><Setter Property="Foreground" Value="#666" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <!-- Each page is a column of white cards; explanations sit in tinted callouts, longer ones in expandable panels -->
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E3E5E8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="16,12,16,14" /><Setter Property="Margin" Value="0,0,0,12" /></Style>
    <Style TargetType="TextBlock" x:Key="CardTitle"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style TargetType="Border" x:Key="Callout"><Setter Property="Background" Value="#EEF4FC" /><Setter Property="BorderBrush" Value="#D3E2F5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,8" /><Setter Property="Margin" Value="0,10,0,0" /></Style>
    <Style TargetType="Border" x:Key="Warning" BasedOn="{StaticResource Callout}"><Setter Property="Background" Value="#FFF6E5" /><Setter Property="BorderBrush" Value="#F0DCAF" /></Style>
    <Style TargetType="TextBlock" x:Key="CalloutIcon"><Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#2F7FD8" /><Setter Property="Margin" Value="0,1,10,0" /><Setter Property="Text" Value="&#xE946;" /><Setter Property="DockPanel.Dock" Value="Left" /></Style>
    <Style TargetType="TextBlock" x:Key="WarningIcon" BasedOn="{StaticResource CalloutIcon}"><Setter Property="Foreground" Value="#B26B00" /><Setter Property="Text" Value="&#xE7BA;" /></Style>
    <Style TargetType="TextBlock" x:Key="CalloutText"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="#2B3A4E" /><Setter Property="LineHeight" Value="19" /></Style>
    <Style TargetType="Expander" x:Key="More"><Setter Property="Margin" Value="0,10,0,0" /><Setter Property="Foreground" Value="#2F6FB8" /></Style>
    <!-- Keycaps for the shortcut tables -->
    <Style TargetType="Border" x:Key="Keycap"><Setter Property="Background" Value="#F3F4F6" /><Setter Property="BorderBrush" Value="#CDD1D7" /><Setter Property="BorderThickness" Value="1,1,1,2" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="6,1" /><Setter Property="Margin" Value="0,2,4,2" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,4" /><Setter Property="Margin" Value="0,0,8,4" /></Style>
    <!-- Tickbox text wraps, so longer translations stay inside the page instead of running past its edge -->
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,0" /><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListView" x:Key="Table">
      <Setter Property="BorderBrush" Value="#E2E2E2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListViewItem"><Setter Property="Focusable" Value="False" /><Setter Property="Padding" Value="4,3" /><Setter Property="Foreground" Value="#1B1E24" /><Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="#F6F8FB" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
      <Setter Property="AlternationCount" Value="2" />
    </Style>
    <!-- Settings pages in a left sidebar, grouped under small section headings; the page's name heads its content -->
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="190" MaxWidth="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#F3F3F3" BorderBrush="#E2E2E2" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" Margin="8,10" /></ScrollViewer></Border>
          <DockPanel Grid.Column="1" Background="#F7F8FA"><TextBlock DockPanel.Dock="Top" Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" FontSize="22" FontWeight="SemiBold" Margin="20,16,20,4" />
            <ContentPresenter ContentSource="SelectedContent" /></DockPanel>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="0,1"><Grid>
          <Border x:Name="selectedBar" Width="3" CornerRadius="1.5" Background="#2F7FD8" HorizontalAlignment="Left" Margin="-8,2,0,2" Visibility="Collapsed" />
          <ContentPresenter ContentSource="Header" /></Grid></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#E6E6E6" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#DDE8F6" /><Setter TargetName="selectedBar" Property="Visibility" Value="Visible" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem" x:Key="SectionHeader">
      <Setter Property="IsEnabled" Value="False" /><Setter Property="Focusable" Value="False" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <ContentPresenter ContentSource="Header" TextElement.Foreground="#888" TextElement.FontSize="11" TextElement.FontWeight="SemiBold" Margin="10,12,0,3" />
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <TabControl x:Name="settingsTabs">
    <TabItem Header="Calendar" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Accounts" x:Name="accountsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Google accounts" Style="{StaticResource CardTitle}" />
            <ItemsControl x:Name="accountsList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="Sign out" Tag="{Binding Email}" Click="SignOut_Click" Margin="0" />
                  <StackPanel><TextBlock Text="{Binding Email}" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" /></StackPanel>
                </DockPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="noAccountsText" Style="{StaticResource Quiet}" Text="No accounts yet." />
            <WrapPanel Margin="0,10,0,0"><Button x:Name="addAccountButton" Content="Sign in with Google…" FontWeight="SemiBold" /><Button x:Name="syncNowButton" Content="Refresh now" /></WrapPanel>
            <Border x:Name="noClientCallout" Style="{StaticResource Warning}" Visibility="Collapsed"><DockPanel><TextBlock Style="{StaticResource WarningIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="This build has no Google sign-in key yet, so accounts can't be added. It comes with a later update." /></DockPanel></Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Callout}" Margin="0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" Text="&#xE72E;" /><TextBlock Style="{StaticResource CalloutText}" Text="Sign-in happens in your browser, on Google's own page. WinGCal keeps a sign-in key for each account, encrypted for your Windows user, and talks only to Google." /></DockPanel></Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Calendars" x:Name="calendarsTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Calendars" Style="{StaticResource CardTitle}" />
            <DockPanel x:Name="calendarsHeader" Margin="0,0,0,2">
              <TextBlock DockPanel.Dock="Right" Text="In switcher" Style="{StaticResource Quiet}" Width="146" />
              <TextBlock Text="Order  Show" Style="{StaticResource Quiet}" Margin="2,0,0,0" xml:space="preserve" />
            </DockPanel>
            <ItemsControl x:Name="calendarsList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding AccountHeading}" Visibility="{Binding HeadingVisibility}" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,10,0,2" />
                  <DockPanel Margin="0,2" Background="White">
                    <Button DockPanel.Dock="Right" Content="Colour…" Tag="{Binding Key}" Click="CalendarColour_Click" Padding="8,1" Margin="0" />
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding InSwitcher, Mode=OneWay}" Tag="{Binding Key}" Click="CalendarInSwitcher_Click" Margin="0,0,62,0" VerticalAlignment="Center" ToolTip="List this calendar in the quick switcher at the top of the window" />
                    <Border DockPanel.Dock="Left" Tag="{Binding Key}" Background="Transparent" Cursor="SizeNS" Padding="6,4" Margin="0,0,6,0" ToolTip="Press and hold, then drag" PreviewMouseLeftButtonDown="CalendarGrip_Down" PreviewMouseMove="CalendarGrip_Move" PreviewMouseLeftButtonUp="CalendarGrip_Up" LostMouseCapture="CalendarGrip_Lost"><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#888" VerticalAlignment="Center" /></Border>
                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding ColourBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Shown, Mode=OneWay}" Tag="{Binding Key}" Click="CalendarShown_Click" Margin="0" VerticalAlignment="Center" />
                  </DockPanel>
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="noCalendarsText" Style="{StaticResource Quiet}" Text="Sign in on Accounts first." />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="New events" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Text="The calendar a new event starts in. You can still change it in the event window." />
            <ComboBox x:Name="defaultCalendarBox" Margin="0,8,0,0" MinWidth="260" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Key" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Sync" x:Name="syncTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="How far back" Style="{StaticResource CardTitle}" />
            <RadioButton x:Name="backMonthsRadio" GroupName="back" Margin="0,6,0,0"><WrapPanel><TextBlock Text="The last" VerticalAlignment="Center" /><TextBox x:Name="backMonthsBox" Width="50" Margin="6,0" /><TextBlock Text="months" VerticalAlignment="Center" /></WrapPanel></RadioButton>
            <RadioButton x:Name="backDateRadio" GroupName="back" Margin="0,8,0,0"><WrapPanel><TextBlock Text="From" VerticalAlignment="Center" /><DatePicker x:Name="backDatePicker" Margin="6,0" Width="140" /></WrapPanel></RadioButton>
            <RadioButton x:Name="backAllRadio" GroupName="back" Content="Everything" Margin="0,8,0,0" />
            <DockPanel Margin="0,14,0,0"><Button DockPanel.Dock="Right" x:Name="firstEventsButton" Content="Find first events" Margin="0" /><TextBlock Text="First event in each calendar" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
            <ListView x:Name="firstEventsTable" Style="{StaticResource Table}" Margin="0,6,0,0" Visibility="Collapsed" HorizontalAlignment="Stretch">
              <ListView.View><GridView><GridViewColumn Header="Calendar" Width="190" DisplayMemberBinding="{Binding Calendar}" /><GridViewColumn Header="First event" Width="150" DisplayMemberBinding="{Binding When}" /><GridViewColumn Header="Title" Width="190" DisplayMemberBinding="{Binding Title}" /></GridView></ListView.View>
            </ListView>
            <TextBlock x:Name="firstEventsStatus" Style="{StaticResource Quiet}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="How far ahead" Style="{StaticResource CardTitle}" />
            <WrapPanel Margin="0,6,0,0"><Slider x:Name="aheadSlider" Minimum="1" Maximum="10" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight" VerticalAlignment="Center" /><TextBlock x:Name="aheadText" Width="80" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" /></WrapPanel>
            <TextBlock Style="{StaticResource Quiet}" Text="Repeating events stop here." />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Refresh" Style="{StaticResource CardTitle}" />
            <WrapPanel Margin="0,6,0,0"><TextBlock Text="Every" VerticalAlignment="Center" /><ComboBox x:Name="refreshBox" Width="110" Margin="8,0"><ComboBoxItem Content="1 minute" Tag="1" /><ComboBoxItem Content="5 minutes" Tag="5" /><ComboBoxItem Content="15 minutes" Tag="15" /><ComboBoxItem Content="1 hour" Tag="60" /></ComboBox></WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Tasks" x:Name="tasksTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel><CheckBox DockPanel.Dock="Right" x:Name="tasksBox" Content="On" Margin="0" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="Google Tasks" Style="{StaticResource CardTitle}" /></DockPanel>
            <TextBlock Style="{StaticResource Quiet}" Text="A task list beside the calendar." />
            <ItemsControl x:Name="taskListsList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate><DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding AccountHeading}" Visibility="{Binding HeadingVisibility}" FontSize="11" FontWeight="SemiBold" Foreground="#888" Margin="0,10,0,2" />
                  <CheckBox Content="{Binding Name}" IsChecked="{Binding Shown, Mode=OneWay}" Tag="{Binding Key}" Click="TaskListShown_Click" Margin="0,2" />
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel x:Name="tasksAccessPanel" Margin="0,8,0,0" Visibility="Collapsed"><Button x:Name="tasksAccessButton" Content="Allow task access…" FontWeight="SemiBold" /><TextBlock x:Name="tasksAccessText" Style="{StaticResource Quiet}" VerticalAlignment="Center" Margin="0" /></WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Export" x:Name="exportTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Back up every event" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Text="One JSON file with everything Google has for each event, from every calendar of the ticked accounts. Not limited to the sync range." />
            <ItemsControl x:Name="exportAccountsList" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Email}" IsChecked="{Binding Chosen}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,12,0,0"><Button x:Name="exportButton" Content="Export…" FontWeight="SemiBold" /><Button x:Name="exportCancelButton" Content="Stop" Visibility="Collapsed" /></WrapPanel>
            <ProgressBar x:Name="exportProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="exportStatus" Style="{StaticResource Quiet}" />
          </StackPanel>
        </Border>
        <Expander Header="What's in the file" Style="{StaticResource More}">
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#2B3A4E" LineHeight="19" Text="Each account, its calendars (name, ID, time zone, colours, default reminders, notification settings and Google's whole calendar entry) and every event exactly as Google stores it: times and time zones, all-day, repeat rules with their changed and cancelled dates, reminders and their kinds, attendees, location, the description with its HTML, video call details, attachments, colours and IDs." />
        </Expander>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="History" x:Name="historyTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Changes you've made" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Text="Every change to an event, newest first (the last 1,000). Undo or redo any of them, in any order. Ctrl+Z and Ctrl+Y in the calendar undo the newest and redo the last undone." />
            <TextBlock x:Name="noHistoryText" Style="{StaticResource Quiet}" Text="Nothing changed yet." Margin="0,10,0,0" />
            <ItemsControl x:Name="historyList" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,3">
                  <Button DockPanel.Dock="Right" Content="{Binding Action}" Tag="{Binding Id}" Click="HistoryAction_Click" MinWidth="64" Margin="8,0,0,0" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Width="110" Foreground="#888" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Summary}" Opacity="{Binding Fade}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Summary}" />
                </DockPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Look" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Appearance" x:Name="appearanceTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Skin" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,6" Text="The calendar changes as you pick." />
            <ComboBox x:Name="skinBox" MinWidth="260" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Colour" Style="{StaticResource CardTitle}" />
            <WrapPanel Margin="0,4,0,0">
              <Border x:Name="accentSwatch" Width="28" Height="22" CornerRadius="4" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,8,0" />
              <Button x:Name="accentChooseButton" Content="Choose…" Margin="0,0,6,0" />
              <Button x:Name="accentResetButton" Content="Reset to default blue" />
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
              <TextBlock Text="Event tint" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
              <Slider x:Name="eventTintSlider" Minimum="0" Maximum="60" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
              <TextBlock x:Name="eventTintText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>
            <WrapPanel Margin="0,6,0,0" ToolTip="A light sweeping across today's and upcoming events in Agenda as they scroll by">
              <TextBlock Text="Strip light" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
              <Slider x:Name="stripLightSlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
              <TextBlock x:Name="stripLightText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Size" Style="{StaticResource CardTitle}" />
            <WrapPanel Margin="0,4,0,0">
              <TextBlock Text="Scale" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
              <Slider x:Name="uiScaleSlider" Minimum="75" Maximum="150" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" />
              <TextBlock x:Name="uiScaleText" Width="50" Margin="8,0,0,0" VerticalAlignment="Center" />
              <Button x:Name="uiScaleResetButton" Content="Reset to 100%" />
            </WrapPanel>
            <TextBlock x:Name="uiScaleSetupText" Style="{StaticResource Quiet}" Margin="108,2,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" x:Name="glassCard">
          <StackPanel>
            <TextBlock Text="Glass" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Text="For the glass skins. Paper, Technical and Wall calendar are solid." />
            <CheckBox x:Name="glassBox" Content="Let the desktop show through the window, frosted (Windows 11)" Margin="0,4,0,8" />
            <StackPanel x:Name="glassControls">
              <CheckBox x:Name="clearGlassBox" Content="Clear window, frosted panels: the window is see-through with a glint at its edge, and each part of it is its own pane of frosted glass" Margin="0,0,0,8" />
              <StackPanel x:Name="clearControls">
                <WrapPanel Margin="0,0,0,4">
                  <TextBlock Text="Window tint" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                  <Slider x:Name="windowTintSlider" Minimum="0" Maximum="60" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                  <TextBlock x:Name="windowTintText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                  <TextBlock Text="Panel tint" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                  <Slider x:Name="panelTintSlider" Minimum="0" Maximum="90" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                  <TextBlock x:Name="panelTintText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,4">
                  <TextBlock Text="Panel frost" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                  <Slider x:Name="panelFrostSlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                  <TextBlock x:Name="panelFrostText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                  <TextBlock Text="Frost grain" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                  <Slider x:Name="panelGrainSlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                  <TextBlock x:Name="panelGrainText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                  <TextBlock Text="Frost colour" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                  <Slider x:Name="frostColourSlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                  <TextBlock x:Name="frostColourText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel Margin="0,0,0,8">
                  <TextBlock Text="Glass thickness" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                  <Slider x:Name="glassThicknessSlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                  <TextBlock x:Name="glassThicknessText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
              </StackPanel>
              <WrapPanel Margin="0,0,0,4" x:Name="transparencyRow">
                <TextBlock Text="Transparency" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                <Slider x:Name="glassTransparencySlider" Minimum="0" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                <TextBlock x:Name="glassTransparencyText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
              </WrapPanel>
              <WrapPanel Margin="0,0,0,4">
                <TextBlock Text="Tint" Margin="0,0,8,0" MinWidth="100" VerticalAlignment="Center" />
                <Slider x:Name="glassTintSlider" Minimum="0" Maximum="360" Width="220" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                <Border x:Name="glassTintSwatch" Width="22" Height="16" CornerRadius="3" Margin="8,0,0,0" BorderBrush="#40FFFFFF" BorderThickness="1" />
                <TextBlock x:Name="glassTintText" Width="60" Margin="6,0,0,0" VerticalAlignment="Center" />
              </WrapPanel>
              <Button x:Name="glassResetButton" Content="Reset glass to default" HorizontalAlignment="Left" Margin="100,2,0,0" />
              <CheckBox x:Name="glassInactiveBox" Content="Keep the glass when WinGCal isn't the active window" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Window" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="framelessBox" Content="Frameless window (default)" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Quiet}" Margin="22,2,0,0" Text="No title bar or standard border: drag from the top strip, resize from the edges. Untick for the standard Windows title bar." />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="Calendar view" x:Name="viewTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Dates and times" Style="{StaticResource CardTitle}" />
            <WrapPanel Margin="0,6,0,0"><TextBlock Text="Week starts on" MinWidth="120" VerticalAlignment="Center" /><ComboBox x:Name="weekStartBox" Width="200"><ComboBoxItem Content="As Windows" Tag="-1" /><ComboBoxItem Content="Monday" Tag="1" /><ComboBoxItem Content="Sunday" Tag="0" /><ComboBoxItem Content="Saturday" Tag="6" /></ComboBox></WrapPanel>
            <WrapPanel Margin="0,8,0,0"><TextBlock Text="Clock" MinWidth="120" VerticalAlignment="Center" /><ComboBox x:Name="clockBox" Width="200"><ComboBoxItem Content="As Windows" Tag="auto" /><ComboBoxItem Content="24-hour (14:30)" Tag="24" /><ComboBoxItem Content="12-hour (2:30pm)" Tag="12" /></ComboBox></WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Events" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="declinedBox" Content="Show events I've declined" Margin="0,4,0,0" />
            <CheckBox x:Name="smoothWheelBox" Content="Smooth scrolling with the mouse wheel (Agenda and Month and days)" Margin="0,8,0,0" />
            <WrapPanel Margin="0,10,0,0">
              <TextBlock Text="Hold to pick up" Margin="0,0,8,0" MinWidth="120" VerticalAlignment="Center" />
              <Slider x:Name="holdSlider" Minimum="150" Maximum="1000" Width="200" IsSnapToTickEnabled="True" TickFrequency="50" VerticalAlignment="Center" />
              <TextBlock x:Name="holdText" Width="70" Margin="8,0,0,0" VerticalAlignment="Center" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Callout}" Margin="0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="Month, week or agenda: the buttons in the window's top strip. Auto picks by the window's size." /></DockPanel></Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="App" Style="{StaticResource SectionHeader}" />
    <TabItem Header="Window" x:Name="windowTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,8,20,16">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel><CheckBox DockPanel.Dock="Right" x:Name="pinnedBox" Content="On" Margin="0" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Text="Pinned to the desktop" Style="{StaticResource CardTitle}" /></DockPanel>
            <ListView Style="{StaticResource Table}" Margin="0,8,0,0" x:Name="pinTable">
              <ListView.View><GridView><GridViewColumn Header="" Width="170" DisplayMemberBinding="{Binding Key}" /><GridViewColumn Header="Pinned" Width="170" DisplayMemberBinding="{Binding Value.Item1}" /><GridViewColumn Header="Unpinned" Width="170" DisplayMemberBinding="{Binding Value.Item2}" /></GridView></ListView.View>
            </ListView>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Monitor setups" Style="{StaticResource CardTitle}" />
            <TextBlock Style="{StaticResource Quiet}" Margin="0,0,0,6" Text="Place, size and scale for each set of monitors." />
            <ItemsControl x:Name="setupsList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="Forget" Tag="{Binding Key}" Click="ForgetSetup_Click" Margin="0" />
                  <StackPanel><TextBlock><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding CurrentLabel, Mode=OneWay}" Foreground="#2E9E44" FontWeight="SemiBold" /></TextBlock><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#666" /></StackPanel>
                </DockPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Start and tray" Style="{StaticResource CardTitle}" />
            <CheckBox x:Name="startWithWindowsBox" Content="Start with Windows" Margin="0,4,0,0" />
            <CheckBox x:Name="trayIconBox" Content="Show an icon in the system tray" Margin="0,6,0,0" />
            <CheckBox x:Name="startMinimisedBox" Content="Start hidden in the tray" Margin="20,6,0,0" />
            <CheckBox x:Name="closeToTrayBox" Content="Close (X) keeps WinGCal running in the tray (otherwise it quits)" Margin="20,6,0,0" />
            <Button x:Name="quitButton" Content="Quit WinGCal" HorizontalAlignment="Left" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem Header="About" x:Name="aboutTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,8,20,16">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="versionText" FontSize="16" FontWeight="SemiBold" />
              <TextBlock x:Name="dataFolderText" Style="{StaticResource Quiet}" />
              <WrapPanel Margin="0,10,0,0"><Button x:Name="openLogsButton" Content="Open logs folder" /><Button x:Name="copyDiagnosticsButton" Content="Copy diagnostics" Margin="8,0,0,0" /><TextBlock x:Name="copyDiagnosticsDone" Style="{StaticResource Quiet}" VerticalAlignment="Center" Margin="10,0,0,0" /></WrapPanel>
              <Border Style="{StaticResource Callout}"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" Text="&#xE72E;" /><TextBlock Style="{StaticResource CalloutText}" Text="The developer takes privacy seriously. WinGCal talks only to Google (your calendars) and GitHub (update checks). Nothing else leaves your PC." /></DockPanel></Border>
              <Expander Header="About the developer" Style="{StaticResource More}">
                <StackPanel Margin="0,6,0,0" TextBlock.Foreground="#2B3A4E">
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Text="Hello, I’m Mat, from London. I wrote this app primarily for me, but I hope you like it too." />
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" Text="Computer Science was my first degree and I’ve been coding since 1988. But you may have guessed AI tools were involved somewhat in the production of WinGCal’s code. Please don’t let that put you off. I’m a critical and careful user of AI, and value human decisions far more than computer-made ones. And so my approach is this: human-led design and human-checked code." />
                  <TextBlock TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0">If something is wrong, or could be improved, please let me know in <Hyperlink x:Name="issuesLink">GitHub Issues</Hyperlink>.</TextBlock>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Updates" Style="{StaticResource CardTitle}" />
              <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="Channel" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="channelCombo" MinWidth="200" Margin="0,0,12,0">
                  <ComboBoxItem Content="Stable releases" Tag="stable" />
                  <ComboBoxItem Content="Dev builds (every change)" Tag="dev" />
                </ComboBox>
                <CheckBox x:Name="autoUpdateBox" Content="Download updates automatically" VerticalAlignment="Center" Margin="0" />
              </WrapPanel>
              <WrapPanel Margin="0,10,0,0">
                <Button x:Name="checkNowButton" Content="Check now" />
                <Button x:Name="restartToUpdateButton" Content="Restart to update" Visibility="Collapsed" FontWeight="SemiBold" />
              </WrapPanel>
              <TextBlock x:Name="updateStatusText" Style="{StaticResource Quiet}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Versions" Style="{StaticResource CardTitle}" />
              <DockPanel Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                  <Button x:Name="refreshVersionsButton" Content="Refresh" Margin="0,0,0,6" />
                  <Button x:Name="switchVersionButton" Content="Switch to this" IsEnabled="False" />
                </StackPanel>
                <ListBox x:Name="versionsList" Height="130">
                  <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Label}" /><TextBlock Text="  ✔ running now" Foreground="#2E9E44" FontWeight="SemiBold" Visibility="{Binding CurrentVisibility}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
              <TextBlock x:Name="versionNotesText" Style="{StaticResource Quiet}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Callout}" Margin="0"><DockPanel><TextBlock Style="{StaticResource CalloutIcon}" /><TextBlock Style="{StaticResource CalloutText}" Text="WinGCal is free software under the GNU GPL v3. Google Calendar and Google Tasks are trademarks of Google LLC; WinGCal isn't made or endorsed by Google." /></DockPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
