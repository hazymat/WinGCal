<Window x:Class="WinGCal.BatchEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change events" Icon="Assets/WinGCal.ico" Width="500" SizeToContent="Height" MinWidth="420" WindowStartupLocation="CenterScreen" Background="#F7F8FA">
  <Window.Resources>
    <Style TargetType="CheckBox"><Setter Property="Width" Value="110" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style TargetType="ComboBox"><Setter Property="MaxDropDownHeight" Value="260" /></Style>
    <Style TargetType="DatePicker"><Setter Property="Width" Value="150" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
    <Style TargetType="TextBlock" x:Key="Hint"><Setter Property="Foreground" Value="#777" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="110,2,0,0" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,5" /><Setter Property="Margin" Value="8,0,0,0" /></Style>
  </Window.Resources>
  <StackPanel Margin="16,14,16,14">
    <Border Background="White" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="8" Padding="16,14">
      <StackPanel>
        <TextBlock x:Name="heading" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="titlesText" Foreground="#666" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,6" />
        <TextBlock Foreground="#555" FontSize="12" Margin="0,4,0,4" TextWrapping="Wrap" Text="Tick what to change. Everything else stays as it is." />
        <DockPanel Margin="0,10,0,0"><CheckBox x:Name="dateTick" Content="Date" /><DatePicker x:Name="datePicker" /></DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="Each event moves to this day, keeping its time and length." />
        <DockPanel Margin="0,10,0,0"><CheckBox x:Name="startTick" Content="Starts at" /><ComboBox x:Name="startTimeBox" IsEditable="True" Width="90" HorizontalAlignment="Left" /></DockPanel>
        <TextBlock Style="{StaticResource Hint}" Text="Keeps each event's length. All-day events become one hour long." />
        <DockPanel Margin="0,10,0,0"><CheckBox x:Name="endTick" Content="Ends at" /><ComboBox x:Name="endTimeBox" IsEditable="True" Width="90" HorizontalAlignment="Left" /></DockPanel>
        <DockPanel Margin="0,10,0,0"><CheckBox x:Name="placeTick" Content="Place" /><TextBox x:Name="placeBox" /></DockPanel>
        <DockPanel x:Name="calendarRow" Margin="0,10,0,0"><CheckBox x:Name="calendarTick" Content="Calendar" /><ComboBox x:Name="calendarBox" DisplayMemberPath="Name" /></DockPanel>
        <TextBlock x:Name="repeatNote" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="Collapsed" Text="Repeating events change only these occurrences, and can't move to another calendar." />
      </StackPanel>
    </Border>
    <TextBlock x:Name="statusText" TextWrapping="Wrap" Margin="2,10,0,0" Visibility="Collapsed" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button x:Name="cancelButton" Content="Cancel" IsCancel="True" /><Button x:Name="applyButton" FontWeight="SemiBold" IsDefault="True" /></StackPanel>
  </StackPanel>
</Window>
